#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/compile_smoke <version> [outdir] [--platform NAME]
#
# The windows port's compile gate (TODO.python/05): stages the version's
# patched tree for one scenario (the Tfs::SourcePrep apply step), runs
# ./configure IN TREE (the runtime factory's shape — tebako-runtime-python
# configures in-tree), and compiles a bounded target set with a bounded
# make. The cheapest compile that proves the PR #2 wall is cleared:
# configure completes on ucrt64 (upstream has zero mingw cases), and the
# translation units that hard-stopped the round-5 windows legs compile.
#
# The wall-TU set (tebako-runtime-python PR #2, round 5 evidence):
#   Python/pylifecycle.o — died on setenv (PY_COERCE_C_LOCALE defined)
#   Python/pytime.o      — died on the non-MS_WINDOWS timeval branch
#   Programs/python.o    — the entry TU (wmain under MS_WINDOWS)
#   Objects/exceptions.o — died on the MS_WINDOWS-gated
#                          #include "errmap.h" (tebako-runtime-python PR
#                          #16, run 34692047817: the POSIX compile line
#                          carries no -I$(srcdir)/PC until
#                          configure_pc_include_msys)
# plus the PR #16 round-2 walls (run 34725669811) and the MSYS2-sweep
# modules whose patches this series carries (v0.3.2):
#   Python/sysmodule.o       — died on VPATH undeclared (MS_WINDOWS
#                              branch; fixed by sysmodule_vpath_msys)
#   Python/thread.o          — died in thread_pthread.h (native_id,
#                              pause; fixed by configure_nt_threads_msys)
#   Modules/posixmodule.o    — the nt-module rename (posixmodule_nt_msys);
#                              died on ioctl/I_PUSH via HAVE_DEV_PTMX under
#                              the msys shell (configure_mingw_defaults_msys,
#                              run 34730588522)
#   Modules/signalmodule.o   — the MS_WINDOWS WSAGetLastError branch
#                              (signal_ws2_32_msys covers the link side);
#                              died on implicit alarm() via HAVE_ALARM
#                              (configure_mingw_defaults_msys, same run)
#   Modules/timemodule.o     — ucrt _timezone spellings (timemodule_msys)
#   Modules/socketmodule.o   — the mingw header gate (socketmodule_msys)
#   Modules/_threadmodule.o  — _PYTHREAD_NAME_MAXLEN consumer
#                              (configure_pthread_name_maxlen_msys)
#   Programs/_bootstrap_python.o — the freeze tool's entry TU (its LINK
#                              wall is 0056's — the full link stays
#                              downstream, though the frozen-header regen
#                              dependency pulls the _freeze_module link
#                              into this gate: run 34732802820)
# plus any .c target the scenario's patch set names — with a presence
# probe: a patch-named stdlib TU compiles only when configure left it a
# literal rule in the generated Makefile (an n/a module — e.g. _ssl
# without an openssl dev package in this env — emits NO rule, and
# make's implicit %.o:%.c fallback would otherwise compile it with the
# wrong flags). Skips are reported in the OK line. WALL_OBJECTS never
# probe: a missing rule there IS the regression. One TU joins
# conditionally: Modules/_io/winconsoleio.o exists only in the patched
# tree (io_winconsoleio_msys, MSYS2 0037 — 0002's HAVE_WINDOWS_CONSOLE_IO
# arm makes it load-bearing; run 34732802820's _freeze_module link died
# on _get_console_type / _PyIO_get_console_type / winconsoleio_spec), so
# it is wall-listed on windows-msys only — the pristine POSIX tree has
# no rule for it and must not fail on its absence. No exts, no install:
# the full runtime build stays the runtime factory's job
# (TODO.python/05 item 2).
#
# Coverage contract (the v0.3.0 gate-gap lesson): the smoke IS the
# factory's shape — in-tree configure + native make, the same scenario
# tree — narrowed only in the TARGET SET (the factory runs full make; the
# smoke compiles the wall set). The set is therefore a regression list:
# every TU that ever hard-stopped the factory's windows build joins
# WALL_OBJECTS in the same PR that fixes it, so the gate reproduces the
# failure before the fix and proves it after. TUs outside the set are
# covered only at the factory — a deliberate delta (link and full-build
# time stay downstream), safe only while this convention holds.
#
# The windows-msys leg runs NATIVELY inside the msys2 ucrt64 shell on a
# windows runner — not a cross compile: config.guess sees
# x86_64-w64-mingw32 and the patched configure takes its mingw arms. The
# linux-gnu leg (a manifest change attributes wide — ReleaseDiff's
# fail-closed rule) runs the same wall set on the POSIX tree. --prefix is
# deliberately absent: the factory's A:/t mount-root prefix and its
# make-parse landmine fix live downstream (tebako-runtime-python round 5);
# the smoke configures with the default prefix and never installs.

$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require "tfs"
require "fileutils"
require "open3"
require "optparse"

WALL_OBJECTS = %w[Python/pylifecycle.o Python/pytime.o Programs/python.o Objects/exceptions.o
                  Python/sysmodule.o Python/thread.o
                  Modules/posixmodule.o Modules/signalmodule.o Modules/timemodule.o
                  Modules/socketmodule.o Modules/_threadmodule.o Programs/_bootstrap_python.o].freeze

# Scenario-only wall TUs: io_winconsoleio_msys (MSYS2 0037) adds
# winconsoleio.c to the _io bootstrap line — the TU has no make rule in
# the pristine POSIX tree, so it can join the never-probed wall set only
# on the platform whose patch set creates it.
WALL_OBJECTS_MSYS = %w[Modules/_io/winconsoleio.o].freeze

PLATFORM_CONFIG = {
  "windows-msys" => { "env" => {}, "configure" => ["--disable-shared"] },
  # The pristine-scenario leg: a manifest change attributes wide (the
  # diff's fail-closed rule), so the gate must be able to compile the
  # POSIX tree too — with nothing patched, this leg re-proves upstream.
  "linux-gnu" => { "env" => {}, "configure" => [] }
}.freeze

def native_platform
  case RUBY_PLATFORM
  when /msys|mingw|cygwin/ then "windows-msys"
  # darwin maps to the POSIX scenario for PATCH SELECTION (the macOS
  # runtime legs consume the unsuffixed tree — tools/apply's rule); the
  # compile itself then runs the host's machdep, a local signal only —
  # CI's linux-gnu leg runs on ubuntu.
  when /linux/, /darwin/ then "linux-gnu"
  else abort "tools/compile_smoke: cannot detect platform #{RUBY_PLATFORM}; pass --platform"
  end
end

options = { platform: nil }
OptionParser.new do |parser|
  parser.banner = "usage: tools/compile_smoke <version> [outdir] [--platform NAME]"
  parser.on("--platform NAME", "windows-msys | linux-gnu (default: host)") { |v| options[:platform] = v }
end.parse!

version = ARGV[0] or abort "usage: tools/compile_smoke <version> [outdir] [--platform NAME]"
outdir = File.expand_path(ARGV[1] || "build/compile-smoke")
platform = options[:platform] || native_platform
config = PLATFORM_CONFIG.fetch(platform) { abort "tools/compile_smoke: no toolchain config for platform #{platform.inspect}" }
cache_dir = ENV.fetch("TFS_CACHE_DIR", Tfs::SourcePrep::DEFAULT_CACHE_DIR)

selection = Tfs::PatchSelection.new
patches = selection.for(version, platform: platform)
auto_objects = patches.map(&:target_file)
                      .select { |target| target.end_with?(".c") }
                      .map { |target| target.sub(/\.c\z/, ".o") }

FileUtils.mkdir_p(outdir)
prep = Tfs::SourcePrep.new(versions: Tfs::Versions.new,
                           selection: selection,
                           cache_dir: cache_dir)
src = prep.prepare(version, outdir, platform: platform)

configure = File.join(src, "configure")
out, err, status = Open3.capture3(config["env"], configure, *config["configure"], chdir: src)
unless status.success?
  tail = (out.lines + err.lines).last(25).join
  abort "tools/compile_smoke: configure failed for #{version} (#{platform})\n#{tail}"
end

# A patch-named stdlib TU is buildable here only when configure left it a
# literal rule (an n/a module emits none — e.g. _ssl with no openssl dev
# package in this env — and make's implicit %.o:%.c fallback would
# compile it with the wrong flags). WALL_OBJECTS (and the platform's
# scenario-only additions) are never probed: a missing rule there is the
# regression the gate exists to catch.
makefile = File.read(File.join(src, "Makefile"))
wall_objects = WALL_OBJECTS + (platform == "windows-msys" ? WALL_OBJECTS_MSYS : [])
buildable, skipped = (auto_objects - wall_objects).uniq.partition do |object|
  makefile.match?(/^#{Regexp.escape(object)}:/)
end
objects = wall_objects + buildable

failing_output = []
failed = objects.reject do |object|
  out, err, status = Open3.capture3("make", "-j2", object, chdir: src)
  failing_output.push("== make #{object} ==\n#{(out.lines + err.lines).last(30).join}") unless status.success?
  status.success?
end
abort "tools/compile_smoke: FAIL #{version} (#{platform}): #{failed.join(', ')} did not compile\n#{failing_output.join}" unless failed.empty?

note = skipped.empty? ? "" : " (n/a in this env, skipped: #{skipped.join(', ')})"
puts "OK #{version} (#{platform}): configure green, #{objects.size} translation units compile (#{objects.join(', ')})#{note}"
