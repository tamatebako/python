# winreg_modules_msys.patch
#
# Target:  Modules/Setup.bootstrap.in + Modules/Setup.stdlib.in +
#          Modules/_winapi.c + PC/msvcrtmodule.c +
#          Python/dynamic_annotations.c + configure.ac + the generated
#          configure (windows-msys scenario)
# Source:  MSYS2 MINGW-packages mingw-w64-python 0018
#          "build: enable winreg, msvcrt, _winapi, winsound and
#          _overlapped modules" (ported verbatim; the generated
#          configure is regenerated with the upstream-pinned autoconf
#          2.72, not hand-synced)
#
# Wall item (observed BOOT wall, tamatebako/python PR #18 CI run
# 34741183330, windows-msys smoke leg — the native ucrt64 oracle):
# every make target died before compiling, at the frozen-module regen:
#   ModuleNotFoundError: No module named 'winreg'
#   Fatal Python error: _PyImport_InitExternal: external importer setup
#   failed
# The frozen importlib._bootstrap_external carries `import winreg` at
# module top level under sys.platform == 'win32'
# (Lib/importlib/_bootstrap_external.py:36), so EVERY interpreter boot
# on the mingw build — _bootstrap_python running the freeze first —
# requires winreg resolvable, and upstream's autoconf build never
# builds it (the module set lives in the MSVC project files). The
# static-shape tree carried the same latent wall; the earlier windows
# legs simply never survived far enough for a boot to prove it (the
# link walls fired first). The patch registers the windows module set:
# winreg/msvcrt/_winapi as BOOTSTRAP modules (static, linked into the
# core — winreg must predate the import system), winsound (-lwinmm)
# and _overlapped (-lws2_32) as stdlib modules, plus the mingw compile
# fixes they need (crtdbg.h is debug-only; dynamic_annotations.c's
# windows.h include gates on MS_WINDOWS). Deferred in v0.3.2 as
# feature parity — promoted by the boot evidence; _winapi is
# subprocess-critical on Windows regardless.
diff --git a/Modules/Setup.bootstrap.in b/Modules/Setup.bootstrap.in
index 0a932d4..ff066b0 100644
--- a/Modules/Setup.bootstrap.in
+++ b/Modules/Setup.bootstrap.in
@@ -40,3 +40,8 @@ _symtable symtablemodule.c
 
 # for systems without $HOME env, used by site._getuserbase()
 @MODULE_PWD_TRUE@pwd pwdmodule.c
+
+# build-in modules for windows platform:
+@MODULE_WINREG_TRUE@winreg ../PC/winreg.c
+@MODULE_MSVCRT_TRUE@msvcrt -DPy_BUILD_CORE ../PC/msvcrtmodule.c
+@MODULE__WINAPI_TRUE@_winapi _winapi.c
