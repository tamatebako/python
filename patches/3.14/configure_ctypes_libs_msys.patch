# configure_ctypes_libs_msys.patch
#
# Target:  configure.ac + the generated configure (windows-msys scenario)
# Source:  MSYS2 MINGW-packages mingw-w64-python 0076
#          "configure: Add libraries to fix ctypes on MINGW" (ported
#          verbatim — v0.3.5 carried a re-authored hunk-3 context
#          (ac_cv_func_dlopen) because the series then lacked 0064;
#          with configure_test_modules_dynamic_loading_msys (0064) in
#          the series, the have_dynamic_loading context is upstream
#          again. The generated configure equivalent is REGENERATED
#          with the upstream-pinned autoconf 2.72 against this patch's
#          exact predecessor state in the series)
#
# Wall item (pre-empted link wall, same leg class as run 34750005177):
# `_ctypes` is in the probe Makefile's SHAREDMODS (the runner has
# libffi; configure_disable_posix_modules_msys gates only
# _posixsubprocess/fcntl/resource/syslog/termios/_scproxy/_posixshmem/
# readline — NOT _ctypes), so it would have been the very next link
# failure after select/_multiprocessing: _ctypes calls
# CoCreateGuid/CoTaskMemAlloc/CLSIDFromString and friends that live
# in ole32/oleaut32/uuid (MSVC gets them via PCbuild). Attaches
# `-lole32 -loleaut32 -luuid` (and the probed libffi) to
# MODULE__CTYPES_LIBS / MODULE__CTYPES_TEST_LIBS under win32.
diff --git a/configure b/configure
index d437804..e3156f4 100755
--- a/configure
+++ b/configure
@@ -16788,6 +16788,14 @@ case $MACHDEP in #(
  ;;
 esac
 
+case $MACHDEP in #(
+  win32) :
+    CTYPES_LIBS="-lole32 -loleaut32 -luuid" ;; #(
+  *) :
+    CTYPES_LIBS=""
+ ;;
+esac
+
 
 
 
@@ -34596,7 +34604,7 @@ fi
 then :
 
     as_fn_append MODULE_BLOCK "MODULE__CTYPES_CFLAGS=$NO_STRICT_OVERFLOW_CFLAGS $LIBFFI_CFLAGS$as_nl"
-    as_fn_append MODULE_BLOCK "MODULE__CTYPES_LDFLAGS=$LIBFFI_LIBS$as_nl"
+    as_fn_append MODULE_BLOCK "MODULE__CTYPES_LDFLAGS=$LIBFFI_LIBS $CTYPES_LIBS$as_nl"
 
 fi
    if test "$py_cv_module__ctypes" = yes; then
@@ -35944,7 +35952,7 @@ fi
 then :
 
 
-    as_fn_append MODULE_BLOCK "MODULE__CTYPES_TEST_LDFLAGS=$LIBM$as_nl"
+    as_fn_append MODULE_BLOCK "MODULE__CTYPES_TEST_LDFLAGS=$LIBM $CTYPES_LIBS$as_nl"
 
 fi
    if test "$py_cv_module__ctypes_test" = yes; then
diff --git a/configure.ac b/configure.ac
index e687ee9..9c9cab9 100644
--- a/configure.ac
+++ b/configure.ac
@@ -4629,6 +4629,12 @@ AS_CASE([$MACHDEP],
   [SELECTMODULE_LIBS=""]
 )
 
+dnl On MINGW, you need to link againt ole32, oleaut32 and uuid for ctypes
+AS_CASE([$MACHDEP],
+  [win32], [CTYPES_LIBS="-lole32 -loleaut32 -luuid"],
+  [CTYPES_LIBS=""]
+)
+
 dnl detect sqlite3 from Emscripten emport
 PY_CHECK_EMSCRIPTEN_PORT([LIBSQLITE3], [-sUSE_SQLITE3])
 
@@ -8754,7 +8760,7 @@ PY_HACL_CREATE_MODULE([HMAC], [_hmac], [test "$ac_sys_system" != "Emscripten"])
 
 PY_STDLIB_MOD([_ctypes],
   [], [test "$have_libffi" = yes],
-  [$NO_STRICT_OVERFLOW_CFLAGS $LIBFFI_CFLAGS], [$LIBFFI_LIBS])
+  [$NO_STRICT_OVERFLOW_CFLAGS $LIBFFI_CFLAGS], [$LIBFFI_LIBS $CTYPES_LIBS])
 PY_STDLIB_MOD([_curses],
   [], [test "$have_curses" = "yes"],
   [$CURSES_CFLAGS], [$CURSES_LIBS]
@@ -8833,7 +8839,7 @@ dnl Check have_libffi so _ctypes_test is only built if _ctypes is built.
 dnl _ctypes_test doesn't use libffi directly.
 PY_STDLIB_MOD([_ctypes_test],
   [test "$TEST_MODULES" = yes], [test "$have_libffi" = yes -a "$have_dynamic_loading" = yes],
-  [], [$LIBM])
+  [], [$LIBM $CTYPES_LIBS])
 
 dnl Limited API template modules.
 dnl Emscripten does not support shared libraries yet.
