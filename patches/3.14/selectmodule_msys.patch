# selectmodule_msys.patch
#
# Target:  Modules/selectmodule.c + configure.ac + the generated
#          configure (windows-msys scenario)
# Source:  MSYS2 MINGW-packages mingw-w64-python 0074
#          "build: add MINGW support for selectmodule" (ported
#          verbatim; the generated configure equivalent is REGENERATED
#          with the upstream-pinned autoconf 2.72 against this patch's
#          exact predecessor state in the series — the generic
#          `then :` / blank / `fi` context of the MODULE_BLOCK hunk is
#          line-anchored, so the anchor must name the select block, not
#          a neighbor's)
#
# Wall item (link wall, trp windows-msys compile-smoke round 4,
# run 34750005177, Makefile:3707):
# `Modules/select.cp314-mingw_x86_64_ucrt_gnu.pyd` failed with
# `undefined reference to __WSAFDIsSet / __imp_select /
# __imp_WSAGetLastError`. Two halves: the .c side widens the
# `_MSC_VER`-only guards to `MS_WIN32` so the winsock select path
# compiles under mingw, and the configure side attaches -lws2_32 to
# MODULE_SELECT_LIBS (MSVC links it via PCbuild; PE needs every
# symbol resolved at link time).
diff --git a/Modules/selectmodule.c b/Modules/selectmodule.c
index 42bf115..2a2e46f 100644
--- a/Modules/selectmodule.c
+++ b/Modules/selectmodule.c
@@ -167,9 +167,9 @@ seq2set(PyObject *seq, fd_set *set, pylist fd2obj[FD_SETSIZE + 1])
         v = PyObject_AsFileDescriptor( o );
         if (v == -1) goto finally;
 
-#if defined(_MSC_VER)
+#if defined(MS_WIN32)
         max = 0;                             /* not used for Win32 */
-#else  /* !_MSC_VER */
+#else  /* !MS_WIN32 */
         if (!_PyIsSelectable_fd(v)) {
             PyErr_SetString(PyExc_ValueError,
                         "filedescriptor out of range in select()");
@@ -177,7 +177,7 @@ seq2set(PyObject *seq, fd_set *set, pylist fd2obj[FD_SETSIZE + 1])
         }
         if (v > max)
             max = v;
-#endif /* _MSC_VER */
+#endif /* MS_WIN32 */
         FD_SET(v, set);
 
         /* add object and its file descriptor to the list */
diff --git a/configure b/configure
index 542cc69..c9b5e7f 100755
--- a/configure
+++ b/configure
@@ -16780,6 +16780,13 @@ case $MACHDEP in #(
  ;;
 esac
 
+case $MACHDEP in #(
+  win32) :
+    SELECTMODULE_LIBS="-lws2_32" ;; #(
+  *) :
+    SELECTMODULE_LIBS=""
+ ;;
+esac
 
 
 
@@ -33100,7 +33107,7 @@ fi
 then :
 
 
-
+    as_fn_append MODULE_BLOCK "MODULE_SELECT_LDFLAGS=$SELECTMODULE_LIBS$as_nl"
 
 fi
 
diff --git a/configure.ac b/configure.ac
index 5b5d8d7..a50826f 100644
--- a/configure.ac
+++ b/configure.ac
@@ -4548,6 +4548,11 @@ AS_CASE([$MACHDEP],
   [MULTIPROCESSING_LIBS=""]
 )
 
+dnl On MINGW, you need to link againt ws2_32 for selectmodule
+AS_CASE([$MACHDEP],
+  [win32], [SELECTMODULE_LIBS="-lws2_32"],
+  [SELECTMODULE_LIBS=""]
+)
 
 dnl detect sqlite3 from Emscripten emport
 PY_CHECK_EMSCRIPTEN_PORT([LIBSQLITE3], [-sUSE_SQLITE3])
@@ -8449,7 +8454,7 @@ PY_STDLIB_MOD_SIMPLE([_posixsubprocess])
 PY_STDLIB_MOD_SIMPLE([_queue])
 PY_STDLIB_MOD_SIMPLE([_random])
 PY_STDLIB_MOD_SIMPLE([_remote_debugging])
-PY_STDLIB_MOD_SIMPLE([select])
+PY_STDLIB_MOD_SIMPLE([select], [], [$SELECTMODULE_LIBS])
 PY_STDLIB_MOD_SIMPLE([_struct])
 PY_STDLIB_MOD_SIMPLE([_types])
 PY_STDLIB_MOD_SIMPLE([_typing])
