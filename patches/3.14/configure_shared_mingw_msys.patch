# configure_shared_mingw_msys.patch
#
# Target:  configure.ac + the generated configure (windows-msys scenario)
# Source:  MSYS2 MINGW-packages mingw-w64-python 0010
#          "configure: add options so that shared build is possible on
#          MINGW" — ported with ONE hunk elided: the closing
#          `LIBS="$LIBS -lversion -lshlwapi -lpathcch -lbcrypt"` case is
#          already carried by configure_syslibs_msys (the tebako
#          deviation), whose post-MODLIBS SYSLIBS position is the one
#          that survives the factory's modlib_rewrites (a pre-MODLIBS
#          LIBS copy of -lbcrypt would not resolve libcrypto's static
#          refs); keeping one carrier beats a verbatim duplicate.
#
# Wall item (observed link wall, tebako-runtime-python PR #16 run
# 34735362057): the four pieces a mingw --enable-shared build needs —
# (1) LDLIBRARY/DLLLIBRARY/BLDLIBRARY names for the enable_shared=yes
#     MINGW case (libpython$(LDVERSION).dll + its .dll.a import library
#     + the -L. -lpython link spelling), plus the static-shape
#     LDLIBRARY=libpython$(LDVERSION).a arm;
# (2) LDSHARED/LDCXXSHARED for MINGW ($(CC) -shared
#     -Wl,--enable-auto-image-base) — upstream's default `ld` answer
#     cannot link a PE shared module;
# (3) LIBPYTHON/MODULE_DEPS_SHARED: on win32 shared builds the stdlib
#     extension rules gain $(LDLIBRARY) as a dependency and
#     MODULE_LDFLAGS_SHARED expands $(BLDLIBRARY), so each
#     Modules/*.cpython-314.so link resolves the core's API against the
#     import library (Makefile.pre.in's generic cygwin-era DLL rule and
#     makesetup's shared rule do the rest — no Makefile hunks needed).
# The generated configure is REGENERATED with the upstream-pinned
# autoconf 2.72 (byte-identical regen against pristine proven, no
# hand-sync; pyconfig.h.in is untouched: no AC_DEFINE involved).
diff --git a/configure b/configure
index 25c93bd..651398a 100755
--- a/configure
+++ b/configure
@@ -7770,6 +7770,11 @@ printf "%s\n" "#define Py_ENABLE_SHARED 1" >>confdefs.h
       BLDLIBRARY='-L. -lpython$(LDVERSION)'
       DLLLIBRARY='libpython$(LDVERSION).dll'
       ;;
+    MINGW*)
+      LDLIBRARY='libpython$(LDVERSION).dll.a'
+      DLLLIBRARY='libpython$(LDVERSION).dll'
+      BLDLIBRARY='-L. -lpython$(LDVERSION)'
+      ;;
     SunOS*)
       LDLIBRARY='libpython$(LDVERSION).so'
       BLDLIBRARY='-Wl,-R,$(LIBDIR) -L. -lpython$(LDVERSION)'
@@ -7829,6 +7834,9 @@ else # shared is disabled
       BLDLIBRARY='$(LIBRARY)'
       LDLIBRARY='libpython$(LDVERSION).dll.a'
       ;;
+    MINGW*)
+      LDLIBRARY='libpython$(LDVERSION).a'
+      ;;
   esac
 fi
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $LDLIBRARY" >&5
@@ -14210,6 +14218,10 @@ fi;;
 	CYGWIN*)
 		LDSHARED="gcc -shared -Wl,--enable-auto-image-base"
 		LDCXXSHARED="g++ -shared -Wl,--enable-auto-image-base";;
+	MINGW*)
+		LDSHARED='$(CC) -shared -Wl,--enable-auto-image-base'
+		LDCXXSHARED='$(CXX) -shared -Wl,--enable-auto-image-base'
+		;;
 	*)	LDSHARED="ld";;
 	esac
 fi
@@ -27418,7 +27430,7 @@ LIBPYTHON=''
 # LIBPYTHON is used by python-config, python3.pc, the commands for building the
 # stdlib's own extension modules, and external package build systems via
 # sysconfig, so its value must be suitable for all those contexts.
-if test "$PY_ENABLE_SHARED" = "1" && ( test -n "$ANDROID_API_LEVEL" || test "$MACHDEP" = "cygwin"); then
+if test "$PY_ENABLE_SHARED" = "1" && ( test -n "$ANDROID_API_LEVEL" || test "$MACHDEP" = "cygwin" || test "$MACHDEP" = "win32"); then
   MODULE_DEPS_SHARED="$MODULE_DEPS_SHARED \$(LDLIBRARY)"
   LIBPYTHON="-lpython${VERSION}${ABIFLAGS}"
 fi
diff --git a/configure.ac b/configure.ac
index 9255f4d..656825c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1604,6 +1604,11 @@ if test $enable_shared = "yes"; then
       BLDLIBRARY='-L. -lpython$(LDVERSION)'
       DLLLIBRARY='libpython$(LDVERSION).dll'
       ;;
+    MINGW*)
+      LDLIBRARY='libpython$(LDVERSION).dll.a'
+      DLLLIBRARY='libpython$(LDVERSION).dll'
+      BLDLIBRARY='-L. -lpython$(LDVERSION)'
+      ;;
     SunOS*)
       LDLIBRARY='libpython$(LDVERSION).so'
       BLDLIBRARY='-Wl,-R,$(LIBDIR) -L. -lpython$(LDVERSION)'
@@ -1663,6 +1668,9 @@ else # shared is disabled
       BLDLIBRARY='$(LIBRARY)'
       LDLIBRARY='libpython$(LDVERSION).dll.a'
       ;;
+    MINGW*)
+      LDLIBRARY='libpython$(LDVERSION).a'
+      ;;
   esac
 fi
 AC_MSG_RESULT([$LDLIBRARY])
@@ -3712,6 +3720,10 @@ then
 	CYGWIN*)
 		LDSHARED="gcc -shared -Wl,--enable-auto-image-base"
 		LDCXXSHARED="g++ -shared -Wl,--enable-auto-image-base";;
+	MINGW*)
+		LDSHARED='$(CC) -shared -Wl,--enable-auto-image-base'
+		LDCXXSHARED='$(CXX) -shared -Wl,--enable-auto-image-base'
+		;;
 	*)	LDSHARED="ld";;
 	esac
 fi
@@ -6599,7 +6611,7 @@ LIBPYTHON=''
 # LIBPYTHON is used by python-config, python3.pc, the commands for building the
 # stdlib's own extension modules, and external package build systems via
 # sysconfig, so its value must be suitable for all those contexts.
-if test "$PY_ENABLE_SHARED" = "1" && ( test -n "$ANDROID_API_LEVEL" || test "$MACHDEP" = "cygwin"); then
+if test "$PY_ENABLE_SHARED" = "1" && ( test -n "$ANDROID_API_LEVEL" || test "$MACHDEP" = "cygwin" || test "$MACHDEP" = "win32"); then
   MODULE_DEPS_SHARED="$MODULE_DEPS_SHARED \$(LDLIBRARY)"
   LIBPYTHON="-lpython${VERSION}${ABIFLAGS}"
 fi
