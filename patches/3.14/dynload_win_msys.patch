# dynload_win_msys.patch
#
# Target:  Makefile.pre.in + configure.ac + the generated configure
#          (windows-msys scenario)
# Source:  MSYS2 MINGW-packages mingw-w64-python 0012
#          "build: Add dynload_win support for MinGW" (ported verbatim;
#          the generated configure is regenerated with the
#          upstream-pinned autoconf 2.72, not hand-synced)
#
# Wall item (observed link wall, local cross proof of the 0009+0010
# series — x86_64-w64-mingw32-gcc 14 on macOS, configure
# --host=x86_64-w64-mingw32 --enable-shared, then `make -j8
# Modules/array.cpython-314.so python.exe`): the libpython3.14.dll link
# died with
#   ld: Modules/getpath.o:getpath.c:(.rdata$.refptr.PyWin_DLLhModule):
#       undefined reference to `PyWin_DLLhModule'
# Modules/getpath.c:811-816 reads PyWin_DLLhModule under
# defined(Py_ENABLE_SHARED) && defined(MS_WINDOWS) — an arm the
# --disable-shared build never compiles, which is why the static tree
# never missed the symbol. The only definition lives in PC/dl_nt.c,
# which upstream compiles solely from the MSVC project files; the
# autoconf build never sees it. The patch does two things for
# *-*-mingw* shared builds: it adds PC/dl_nt.o to extra_machdep_objs
# (defining PyWin_DLLhModule and PyWin_DLLVersionString — the latter
# needs MS_DLL_ID, see ms_dll_id_msys), and it selects
# DYNLOADFILE=dynload_win.o, the LoadLibrary-based loader. The loader
# switch is not optional either: base mingw has no dlopen (configure
# falls back to dynload_stub.o — "dynamic loading not supported" at
# run time), so without dynload_win the freshly linked
# Modules/*.pyd set would be unloadable.
#
# Coherence note: dynload_win's import filetab is .pyd-based
# (PYD_TAGGED_SUFFIX/PYD_UNTAGGED_SUFFIX in Include/internal/
# pycore_importdl.h), so the naming trio pyd_platform_tag_msys /
# pyd_suffix_msys / soabi_ext_suffix_msys joins the series in the same
# step — build-time EXT_SUFFIX and run-time import suffixes must
# agree, and upstream's configure default (.so) cannot match a .pyd
# filetab. POSIX legs untouched (both hunks gate on mingw).
diff --git a/Makefile.pre.in b/Makefile.pre.in
index 12edd93..54c7124 100644
--- a/Makefile.pre.in
+++ b/Makefile.pre.in
@@ -1971,6 +1971,12 @@ Python/dynload_hpux.o: $(srcdir)/Python/dynload_hpux.c Makefile
 		-DSHLIB_EXT='"$(EXT_SUFFIX)"' \
 		-o $@ $(srcdir)/Python/dynload_hpux.c
 
+Python/dynload_win.o: $(srcdir)/Python/dynload_win.c Makefile
+	$(CC) -c $(PY_CORE_CFLAGS) \
+		-DPYD_PLATFORM_TAG='"$(PYD_PLATFORM_TAG)"' \
+		-DPY3_DLLNAME='L"$(DLLLIBRARY)"' \
+		-o $@ $(srcdir)/Python/dynload_win.c
+
 Python/sysmodule.o: $(srcdir)/Python/sysmodule.c Makefile $(srcdir)/Include/pydtrace.h
 	$(CC) -c $(PY_CORE_CFLAGS) \
 		-DABIFLAGS='"$(ABIFLAGS)"' \
diff --git a/configure b/configure
index 9291864..591ef8a 100755
--- a/configure
+++ b/configure
@@ -19751,6 +19751,12 @@ then
 	fi
 	;;
 	esac
+	case $host in
+	*-*-mingw*)
+    DYNLOADFILE="dynload_win.o"
+    extra_machdep_objs="$extra_machdep_objs PC/dl_nt.o"
+    ;;
+	esac
 fi
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $DYNLOADFILE" >&5
 printf "%s\n" "$DYNLOADFILE" >&6; }
diff --git a/configure.ac b/configure.ac
index 2f0b329..caafecd 100644
--- a/configure.ac
+++ b/configure.ac
@@ -5393,6 +5393,12 @@ then
 	fi
 	;;
 	esac
+	case $host in
+	*-*-mingw*)
+    DYNLOADFILE="dynload_win.o"
+    extra_machdep_objs="$extra_machdep_objs PC/dl_nt.o"
+    ;;
+	esac
 fi
 AC_MSG_RESULT([$DYNLOADFILE])
 if test "$DYNLOADFILE" != "dynload_stub.o"
